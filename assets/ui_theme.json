{
    "#score_label": {
        "font": {
            "name": "assets/images/Oxanium-Bold.ttf",
            "size": 24,
            "bold": true
        },
        "text_colour": "#00FF00",
        "bg_colour": "#000000",
        "border_width": 2,
        "border_colour": "#00FF00"
    },
    "#health_label_text": {
        "font": {
            "name": "assets/images/Oxanium-Bold.ttf",
            "size": 20,
            "bold": true
        },
        "text_colour": "#FFFFFF"
    },
    "#health_bar": {
        "bar_height": 20,
        "filled_bar": {
            "colour": "#FF0000"

        "unfilled_bar": {
            "colour": "#400000"
        },
        "border_width": 2,
        "border_colour": "#FFFFFF"
    },
    "#cooldown_label_text": {
        "font": {
            "name": "assets/images/Oxanium-Bold.ttf",
            "size": 20,
            "bold": true
        },
        "text_colour": "#FFFFFF"
    },
    "#cooldown_bar": {
        "bar_height": 20,
        "filled_bar": {
